{
  "target": {
    "name": "16-bit 차체 제어 MCU (예시)",
    "int_bits": 16,
    "long_bits": 32,
    "short_bits": 16,
    "pointer_bits": 16,
    "char_signed": false,
    "atomic_access_bits": 8
  },
  "contexts": [
    {"name": "OsTask_10ms", "kind": "task", "entries": ["BlvDiag_MainFunction"],
     "period_ms": 10, "priority": 5, "preemptive": true},
    {"name": "ADC_ConvEnd_ISR", "kind": "isr", "entries": ["Adc_ConvEndIsr"], "priority": 100,
     "notes": "ADC 변환 완료 시 약 1ms 주기로 발생"},
    {"name": "EcuM_Init", "kind": "init", "entries": ["BlvDiag_Init"], "concurrent": false,
     "notes": "인터럽트 허용 전 1회 호출, Wake-up 시 재호출"}
  ],
  "protection": {
    "enter": ["SuspendAllInterrupts", "DisableAllInterrupts", "SchM_Enter_*"],
    "exit": ["ResumeAllInterrupts", "EnableAllInterrupts", "SchM_Exit_*"]
  },
  "notes": [
    "ADC는 10bit (0..1023), 기준전압 5000mV, 분압비 1/4",
    "Dem_SetEventStatus는 동일 상태 반복 보고 허용"
  ]
}
